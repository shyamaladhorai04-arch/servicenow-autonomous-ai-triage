        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // Instantiate our Script Include
    var triage = new x_snc_ai_triage.AITriageEngine();

    // Calculate priority and resolution plan
    var newPriority = triage.evaluatePriority(current.short_description);
    var aiPlan = triage.generateFixPlan(current.short_description);

    // Update Incident Record
    current.priority = newPriority;
    current.u_ai_resolution_plan = aiPlan; // Assigns plan to custom field
    current.work_notes = "]]>🤖<![CDATA[ Autonomous AI Triage engine executed. Priority set to: " + newPriority;
    
    current.update();

})(current, previous);]]></script>
